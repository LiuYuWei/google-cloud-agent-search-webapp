# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored.

GCP_PROJECT_ID=your-gcp-project-id
DISCOVERY_ENGINE_LOCATION=global
DISCOVERY_ENGINE_COLLECTION=default_collection
DISCOVERY_ENGINE_ID=your-engine-id
DISCOVERY_ENGINE_SERVING_CONFIG=default_search

# Optional: override the system prompt (preamble) sent to the Answer API.
# Leave unset to use the built-in Taiwan Traditional Chinese preamble.
# ANSWER_PREAMBLE="你是…請用台灣繁體中文回答…"
